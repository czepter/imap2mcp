# Public base URL (https in production). MCP resource = ${BASE_URL}/mcp
BASE_URL=https://your-domain.com
PORT=3000
DATA_DIR=./data

# REQUIRED, no defaults. The server refuses to start without them.
# Master key: 32 bytes, hex (64 chars) or base64. Prefer a key file on a secret mount.
#   openssl rand -hex 32 > /run/secrets/imap2mcp_key
ENCRYPTION_KEY_FILE=/run/secrets/imap2mcp_key
# ENCRYPTION_KEY=   # alternative: 64 hex chars
# Session cookie signing secret, >= 32 chars:  openssl rand -hex 32
SESSION_SECRET=

# Optional: fixed one-time bootstrap token for /setup (otherwise printed to stdout on first run)
# ADMIN_BOOTSTRAP_TOKEN=

# dynamic (RFC 7591, grants nothing) or admin (clients created in UI only)
REGISTRATION_MODE=dynamic
# Comma list of mailbox hosts allowed to resolve to private IPs
ALLOW_PRIVATE_HOSTS=
# CORS origin for MCP/OAuth endpoints (default: reflect)
# CORS_ORIGIN=
