# imap2mcp configuration. Copy to `.env` (git-ignored). docker compose reads `.env` automatically for the
# variables docker-compose.yml references (BASE_URL, SESSION_SECRET, HOST_PORT, REGISTRATION_MODE, ALLOW_PRIVATE_HOSTS,
# ADMIN_BOOTSTRAP_TOKEN, LOG_LEVEL, AUDIT_FAIL_MODE, AUDIT_RETENTION_DAYS). Without Docker, export the same names.
# Full reference: docs/OPERATIONS.md

# ---- Required (no defaults; the server refuses to start without them) --------------------------------------------
# Public base URL (https in production). MCP resource / token audience = ${BASE_URL}/mcp.
# Changing it later invalidates every issued token.
BASE_URL=https://your-domain.com
# Session cookie signing secret, >= 32 characters:  openssl rand -hex 32
SESSION_SECRET=
# Alternative: path of a file containing the secret (used when SESSION_SECRET is empty).
# SESSION_SECRET_FILE=/run/secrets/session_secret
# Master key for mailbox passwords: 32 bytes, 64 hex chars or base64, in a FILE outside the data dir and the image:
#   openssl rand -hex 32 > secrets/imap2mcp_key && chmod 600 secrets/imap2mcp_key
# docker-compose.yml mounts ./secrets/imap2mcp_key at /run/secrets/imap2mcp_key and sets ENCRYPTION_KEY_FILE for you.
# Without Docker:
# ENCRYPTION_KEY_FILE=/run/secrets/imap2mcp_key
# ENCRYPTION_KEY=            # alternative: 64 hex chars (leaks into process listings; prefer the file)

# ---- Common ------------------------------------------------------------------------------------------------------
# Host port the compose file publishes on 127.0.0.1 (the reverse proxy connects here). Container port stays 3000.
HOST_PORT=3000
# Port the process listens on (non-Docker only) and where it keeps bridge.db, backups/ and sidecar.sock.
# PORT=3000
# DATA_DIR=./data
# dynamic (RFC 7591; registering grants nothing) or admin (clients are created in the UI only)
REGISTRATION_MODE=dynamic
# Comma list of mailbox host NAMES allowed to resolve to private/loopback addresses (exact match; IP literals literally)
ALLOW_PRIVATE_HOSTS=
# Fixed one-time /setup token instead of a random one printed to the log on first run. Unset it after setup.
# ADMIN_BOOTSTRAP_TOKEN=
# CORS origin for /mcp and the OAuth machine endpoints (default: reflect the request origin, never with credentials)
# CORS_ORIGIN=

# ---- Logging and audit (v2) --------------------------------------------------------------------------------------
# debug | info | warn | error. JSON lines on stdout, secrets redacted.
LOG_LEVEL=info
# closed (default): if the audit row cannot be written the tool call fails with UNAVAILABLE. open: log to stderr and continue.
AUDIT_FAIL_MODE=closed
# Days to keep audit events; 0 = forever. Pruned at startup and every 24 h.
AUDIT_RETENTION_DAYS=90

# ---- Sidecar and IMAP tuning (defaults are right for almost everyone) ------------------------------------------
# SIDECAR_BIN=sidecar/bin/sidecar     # path of the Go sidecar binary (the image sets up sidecar/bin/sidecar)
# SIDECAR_DISABLED=1                  # debugging only: v0 direct IMAP path, no cache, no IDLE
# SIDECAR_EXTRA_CA_FILE=              # extra CA bundle for IMAP TLS (private CA). Also set NODE_EXTRA_CA_CERTS for the Node path.
# SYNC_RECONCILE_SECS=30              # sidecar UID/flag reconciliation interval
# IDLE_RENEW_SECS=1500                # renew IMAP IDLE before the provider's ~29-30 min deadline
# SIDECAR_AUTOSYNC_SECS=              # background sync interval where the sidecar supports it
# IDLE_POLL_SECS=60                   # polling interval for servers without IDLE
# RECONNECT_INITIAL_MS=1000           # tests only: backoff start (production: leave unset)
# RECONNECT_MAX_MS=60000              # tests only: backoff cap (production: leave unset)
# RECONNECT_HEALTHY_MS=30000          # tests only: healthy period that resets the backoff
