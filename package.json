{
  "name": "imap2mcp",
  "version": "0.1.0",
  "description": "Multi-agent multi-user HTTP IMAP bridge with OAuth 2.1 for MCP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "smoke": "scripts/smoke.sh",
    "smoke:reuse": "SMOKE_IMAGE=imap2mcp:smoke scripts/smoke.sh",
    "audit:export": "node dist/audit/cli.js",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "build:sidecar": "scripts/go.sh build -o bin/sidecar ./cmd/sidecar",
    "bench": "tsx bench/run.ts",
    "test:v1": "vitest run test/integration/v1-"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "imapflow": "^1.0.171",
    "nodemailer": "^6.9.16",
    "uuid": "^11.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0"
  }
}
