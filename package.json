{
  "name": "imap2mcp",
  "version": "0.1.0",
  "description": "Multi-agent multi-user HTTP IMAP bridge with OAuth 2.1 for MCP",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/build-cli.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:v1": "vitest run test/integration/v1-",
    "smoke": "scripts/smoke.sh",
    "smoke:reuse": "SMOKE_IMAGE=imap2mcp:smoke scripts/smoke.sh",
    "audit:export": "node dist/audit/cli.js",
    "db:generate": "drizzle-kit generate",
    "build:sidecar": "scripts/go.sh build -o bin/sidecar ./cmd/sidecar",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.71.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "imapflow": "^1.0.171",
    "nodemailer": "^10.4.0",
    "nuxt": "^4.6.4",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^6.4.17",
    "@types/uuid": "^10.0.0",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "shadcn-nuxt": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
